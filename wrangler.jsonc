// Cloudflare Workers deploy config.
// The build runs `npx wrangler deploy`, which reads this file.
// assets.directory = ONLY public/ ships to arkives.xyz. Migrations
// (which contain private business data in the seed files) and legacy
// files at the repo root are never served.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arkives",
  "compatibility_date": "2026-07-13",
  "observability": {
    "enabled": true
  },
  // worker/ handles /api/* only (the follower scan); secrets live in the
  // Cloudflare dashboard: APIFY_TOKEN (required), SCAN_ALLOWED_EMAILS (optional).
  "main": "worker/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
