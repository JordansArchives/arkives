{
  "name": "arkives",
  "version": "0.1.0",
  "private": true,
  "description": "Arkives — creator partnership CRM (vanilla JS + Supabase, served from public/ on Cloudflare Workers)",
  "type": "module",
  "scripts": {
    "globals": "node tools/app-globals.mjs",
    "lint": "npm run globals && eslint .",
    "test": "npm run test:checks && npm run test:smoke",
    "test:checks": "node tests/checks.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "serve": "python3 -m http.server 8741 --directory public"
  },
  "devDependencies": {
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "playwright-core": "^1.55.0"
  },
  "engines": {
    "node": ">=20"
  }
}
